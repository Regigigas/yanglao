# Transitional shared MySQL database. Each bounded context owns its tables;
# schema-per-service can be introduced later without changing public APIs.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ry-cloud
DB_USER=root
DB_PASSWORD=password
DB_POOL_SIZE=10

# Keep the legacy value while existing Java-issued tokens are being migrated.
# Replace it in production after forcing all users to sign in again.
JWT_SECRET=abcdefghijklmnopqrstuvwxyz
JWT_EXPIRES_IN=720m
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_REQUIRED=false

GATEWAY_PORT=8080
AUTH_PORT=9200
IDENTITY_PORT=9201
GENERATOR_PORT=9202
SCHEDULER_PORT=9203
PLATFORM_PORT=9204
PROCUREMENT_PORT=9205
COLLABORATION_PORT=9206
SYNC_PORT=9207
FILE_PORT=9300
MONITOR_PORT=9100

AUTH_SERVICE_URL=http://127.0.0.1:9200
IDENTITY_SERVICE_URL=http://127.0.0.1:9201
PLATFORM_SERVICE_URL=http://127.0.0.1:9204
PROCUREMENT_SERVICE_URL=http://127.0.0.1:9205
COLLABORATION_SERVICE_URL=http://127.0.0.1:9206
SYNC_SERVICE_URL=http://127.0.0.1:9207
GENERATOR_SERVICE_URL=http://127.0.0.1:9202
SCHEDULER_SERVICE_URL=http://127.0.0.1:9203
FILE_SERVICE_URL=http://127.0.0.1:9300
UPLOAD_DIR=./uploads
FILE_PUBLIC_URL=http://127.0.0.1:8080/file/statics

# 与原系统一致，登录和注册使用 Redis 数学验证码。
CAPTCHA_ENABLED=true
CAPTCHA_TTL_SECONDS=120
XSS_ENABLED=true
XSS_EXCLUDE_PATHS=/notice
BLACKLIST_URLS=
