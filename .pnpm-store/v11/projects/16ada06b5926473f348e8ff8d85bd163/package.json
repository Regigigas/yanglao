{
  "name": "yanglao-workspace",
  "version": "1.1.0",
  "private": true,
  "description": "养老管理系统 - Electron + Vue3 monorepo",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm -F @yanglao/desktop dev",
    "build": "pnpm -F @yanglao/desktop build",
    "build:win": "pnpm -F @yanglao/desktop build:win",
    "build:mac": "pnpm -F @yanglao/desktop build:mac",
    "build:linux": "pnpm -F @yanglao/desktop build:linux",
    "preview": "pnpm -F @yanglao/desktop preview",
    "test": "pnpm -r --if-present test",
    "test:ci": "pnpm -r --if-present test -- --reporter=verbose",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:style": "stylelint \"**/*.{css,scss,vue}\"",
    "lint:style:fix": "stylelint \"**/*.{css,scss,vue}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "clean": "pnpm -r exec -- rm -rf node_modules dist",
    "rebuild": "pnpm -F @yanglao/desktop rebuild"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix",
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "postcss-html": "1.8.1",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-recommended-vue": "1.6.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
