# ── 业务 API 基础地址 ─────────────────────────────────────────
# 渲染进程所有业务请求的 baseURL（留空则为相对路径）
VITE_API_BASE_URL=https://your-api-server.com/api

# ── 请求超时（毫秒） ──────────────────────────────────────────
# 默认 10000ms = 10s
VITE_REQUEST_TIMEOUT_MS=10000

# ── 远程数据同步服务端地址 ────────────────────────────────────
# 同步引擎（主进程）使用，与业务 API 可以不同
# 留空则禁用网络同步
VITE_SYNC_SERVER_URL=https://your-server.com/api/sync

# ── 同步默认间隔（毫秒） ──────────────────────────────────────
# 自动模式下每隔多少 ms 触发一次同步，默认 300000ms = 5 分钟
VITE_SYNC_INTERVAL_MS=300000
