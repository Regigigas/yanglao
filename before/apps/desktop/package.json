{
  "name": "@yanglao/desktop",
  "version": "1.1.0",
  "private": true,
  "description": "养老管理系统 Electron 桌面端",
  "author": "Regigigas",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "vue-tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "pnpm build && electron-builder --win --config electron-builder.config.ts --publish never",
    "build:mac": "pnpm build && electron-builder --mac --config electron-builder.config.ts --publish never",
    "build:linux": "pnpm build && electron-builder --linux --config electron-builder.config.ts --publish never",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@electron-toolkit/utils": "4.0.0",
    "@yanglao/core": "workspace:*",
    "@yanglao/db": "workspace:*",
    "@yanglao/sync": "workspace:*",
    "@yanglao/ui": "workspace:*",
    "axios": "1.18.1",
    "better-sqlite3": "13.0.1",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "nanoid": "6.0.0",
    "node-cron": "4.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@iconify-json/ion": "^1.2.7",
    "@iconify/vue": "5.0.1",
    "@tanstack/vue-query": "5.101.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.1",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vueuse/core": "14.3.0",
    "@vueuse/motion": "3.0.3",
    "dayjs": "1.11.21",
    "echarts": "6.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "naive-ui": "2.44.1",
    "pinia": "4.0.2",
    "sass": "1.102.0",
    "typescript": "5.9.3",
    "unocss": "66.7.5",
    "unplugin-auto-import": "21.0.0",
    "unplugin-vue-components": "32.1.0",
    "vitest": "3.2.4",
    "vue": "3.5.40",
    "vue-echarts": "8.0.1",
    "vue-router": "5.2.0",
    "vue-tsc": "3.3.8",
    "zod": "4.4.3"
  }
}
